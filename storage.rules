rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper para verificar pertenencia al negocio vía Firestore
    function perteneceANegocio(negocioId) {
      return request.auth != null && 
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.negocioId == negocioId;
    }

    // Reglas para importaciones masivas
    match /importaciones/{negocioId}/{allPaths=**} {
      // Solo miembros del negocio pueden subir archivos para procesar
      allow read, write: if perteneceANegocio(negocioId);
    }

    // Reglas para logos de negocio (si los hay)
    match /negocios/{negocioId}/{allPaths=**} {
      allow read: if true; // Logos son públicos
      allow write: if perteneceANegocio(negocioId);
    }
  }
}
